{
    "name": "@rapiq/core",
    "version": "2.4.0",
    "description": "The rapiq foundation: typed query AST, defineQuery build layer, schema allow-list system & visitor interfaces.",
    "type": "module",
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "browser": "./dist/browser.mjs",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist/",
        "binding/index.cjs",
        "binding/index.d.cts"
    ],
    "scripts": {
        "build:binding": "napi build --platform --release --manifest-path binding/Cargo.toml --output-dir binding --js index.cjs --dts index.d.cts",
        "build:binding:wasm": "napi build --platform --release --target wasm32-wasip1 --no-default-features --manifest-path binding/Cargo.toml --output-dir binding --no-js --dts index.wasm.d.cts",
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "npm run build:binding && npm run build:types && npm run build:js",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage",
        "prepublishOnly": "npm run build"
    },
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "license": "MIT",
    "publishConfig": {
        "access": "public",
        "tag": "latest"
    },
    "keywords": [
        "query",
        "json",
        "json-api",
        "api",
        "rest",
        "api-utils",
        "include",
        "pagination",
        "sort",
        "fields",
        "filter",
        "relations",
        "typescript"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Tada5hi/rapiq.git",
        "directory": "packages/core/node"
    },
    "bugs": {
        "url": "https://github.com/Tada5hi/rapiq/issues"
    },
    "homepage": "https://github.com/Tada5hi/rapiq#readme",
    "dependencies": {
        "@ebec/core": "^1.3.2",
        "pathtrace": "^2.2.3"
    },
    "napi": {
        "binaryName": "rapiq-core",
        "packageName": "@rapiq/core",
        "targets": [
            "x86_64-unknown-linux-gnu",
            "aarch64-unknown-linux-gnu",
            "x86_64-unknown-linux-musl",
            "aarch64-unknown-linux-musl",
            "x86_64-apple-darwin",
            "aarch64-apple-darwin",
            "x86_64-pc-windows-msvc",
            "wasm32-wasip1"
        ]
    },
    "devDependencies": {
        "@emnapi/core": "2.0.0-alpha.6",
        "@emnapi/runtime": "2.0.0-alpha.6",
        "@napi-rs/cli": "^3.10.8",
        "@napi-rs/wasm-runtime": "^1.2.5",
        "emnapi": "2.0.0-alpha.6"
    },
    "nx": {
        "targets": {
            "build": {
                "outputs": [
                    "{projectRoot}/dist",
                    "{projectRoot}/binding/*.node"
                ]
            }
        }
    }
}
