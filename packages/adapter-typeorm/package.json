{
    "name": "@rapiq/adapter-typeorm",
    "version": "2.0.0",
    "description": "Apply a rapiq query directly to a TypeORM SelectQueryBuilder (filters, relations, fields, sort & pagination).",
    "type": "module",
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist/"
    ],
    "dependencies": {
        "change-case": "^5.4.4"
    },
    "devDependencies": {
        "@rapiq/core": "^2.0.0",
        "@rapiq/parser-simple": "^2.0.0",
        "@rapiq/adapter-sql": "^2.0.0",
        "@swc/core": "^1.15.47",
        "ansis": "^4.2.0",
        "better-sqlite3": "^12.6.0",
        "mysql2": "^3.22.6",
        "pg": "^8.23.0",
        "reflect-metadata": "^0.2.2",
        "typeorm": "^1.1.0",
        "unplugin-swc": "^1.5.10"
    },
    "peerDependencies": {
        "@rapiq/core": "^2.0.0",
        "@rapiq/adapter-memory": "^2.0.0",
        "@rapiq/adapter-sql": "^2.0.0",
        "typeorm": "^1.1.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "npm run build:types && npm run build:js",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage",
        "test:db": "vitest --config test/vitest.config.ts --run .db.spec",
        "prepublishOnly": "npm run build"
    },
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "license": "MIT",
    "publishConfig": {
        "access": "public",
        "tag": "latest"
    },
    "keywords": [
        "query",
        "json",
        "json-api",
        "api",
        "rest",
        "api-utils",
        "typeorm",
        "include",
        "pagination",
        "sort",
        "fields",
        "filter",
        "relations",
        "typescript"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Tada5hi/rapiq.git",
        "directory": "packages/adapter-typeorm"
    },
    "bugs": {
        "url": "https://github.com/Tada5hi/rapiq/issues"
    },
    "homepage": "https://github.com/Tada5hi/rapiq#readme",
    "peerDependenciesMeta": {
        "@rapiq/adapter-memory": {
            "optional": true
        }
    }
}
